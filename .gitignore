# ── Node.js ──
node_modules/
dist/
.npm
*.tsbuildinfo

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.whl

# ── Rust / Tauri ──
src-tauri/target/
src-tauri/gen/
**/*.rs.bk

# ── IDE ──
.vscode/
.idea/
.history/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── 构建产物 ──
*.dmg
*.AppImage
*.msi
*.exe
!src-tauri/icons/*.ico
!src-tauri/icons/*.png
!src-tauri/icons/*.icns

# ── PyInstaller / Nuitka ──
build/
dist/
# 例外：rule-packs/dist 是官方规则包索引的下载地址（raw.githubusercontent 必须取到），
# 不是构建垃圾；这里一忽略，设置页的「检查规则包更新」就永远 404
!rule-packs/dist/
!rule-packs/dist/*.zip
*.spec
src-tauri/*.dll
src-tauri/*.pyd
# flatten_dependencies() 提升出来的动态库（macOS 是 .dylib/.so，Linux 是 .so 与
# libpython3.12.so.1.0 这种带版本后缀的 .so.*）——v2.3.17 起 Linux 连 sidecar exe 一起
# 提升到这一层，根目录产物比原来多，不忽略的话 `git status` 会被构建产物淹没
src-tauri/*.so
src-tauri/*.so.*
src-tauri/*.dylib
src-tauri/hancast_sidecar/
src-tauri/certifi/
src-tauri/lxml/
src-tauri/charset_normalizer/
src-tauri/curl_cffi/
src-tauri/dist-portable/
# 不带尾斜杠：Windows/macOS 上它是 Nuitka dist 目录，Linux 上是提升出来的 sidecar 可执行文件
# （Linux 的 dist 挪到 src-tauri/target/sidecar-dist/，已被上面的 src-tauri/target/ 覆盖）
src-tauri/hancast-sidecar
# Wayland 抓取 helper：CI 在 linux job 里 cargo build 之后拷到这一层给
# bundle.resources 的 "hancast-wlgrab" glob 用，属构建产物
src-tauri/hancast-wlgrab

# hancast-wlgrab（Linux/Wayland 屏幕抓取 helper）的本地构建产物；
# Cargo.lock 要入库——它是二进制依赖的锁定证据，CI 靠 --locked 复现同一份
linux-capture/target/

# ── 日志 ──
*.log
logs/

# ── 系统 ──
.Spotlight-V100
.Trashes
.fseventsd
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# ── BMad (框架文件，不纳入项目) ──
_bmad/
_bmad-output/
.claude/skills/
.claude/plans/
.claude/
# ── 原始参考代码 (仅参考，不纳入主项目) ──
Macast-main/

# ── MPV 播放器 (外部依赖，不纳入版本控制) ──
# 只忽略 mpv 二进制/动态库，但保留我们自带的配置与脚本（portable_config/）
mpv/*
!mpv/portable_config/

.understand-anything/

# Claude Code 专用启动脚本（本地使用）
scripts/claude-frontend.bat
scripts/claude-backend.bat
scripts/claude-knowledge.bat
scripts/claude-dashboard.bat

# 微软打包
MSIX/

hancast-backend/mpv_diag.txt

# pi 追踪目录
.pi-traces/

# 本地临时工作区（探针脚本、验收截图与产物；不入库）
.tmp-win/
