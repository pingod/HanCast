<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- macOS 15+ 把「本地网络」做成 TCC 权限：缺声明的应用不会弹窗询问，
	     而是被静默拒绝。表现全部集中在投屏链路上——出站组播
	     [Errno 65] No route to host（SSDP 发不出去，只能靠子网广播兜底），
	     入站 LAN 连接握手后零字节。
	     两条声明都要写，缺一不可：
	       只写 NSLocalNetworkUsageDescription → 单播/入站通，组播仍 Errno 65；
	       再补 NSBonjourServices=["_upnp._tcp"] → 「通道 multicast / 24 条」。
	     组播的收发在 Apple 那边归 Bonjour/mDNS 管辖，所以要按 UPnP 规范报出
	     _upnp._tcp；本程序不使用其它 Bonjour 服务类型，多写等于白要权限。
	     但**光有 plist 还不够**（2.2.13 就是这么翻车的）：这套权限按*代码身份*判定，
	     CI 不签名时主程序只有 Rust 链接器写的 adhoc 签名
	     （Identifier=`HanCast-<hex>`、flags=linker-signed），每次构建换一个身份，
	     NetworkAgent 认不出→照旧静默拒绝，而且 TCC.db 里连记录都不会有。
	     所以 build.yml 在打 dmg 之前必须 `codesign --force --deep --sign -`，
	     并断言签名 Identifier 等于 bundle id。
	     这个文件必须纳入版本控制：CI 从仓库构建，本地未跟踪的副本不会进产物。 -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>HanCast 需要访问本地网络，用于发现局域网内的 DLNA 电视与投屏设备并与它们通信。</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_upnp._tcp</string>
	</array>
	<!-- 投屏要采麦克风，ScreenCaptureKit 采系统声音同样要求这条声明。
	     缺它的后果不是「弹窗询问被拒」，而是**根本不弹**：TCC 直接判「拒绝且
	     不再提示」，于是 ffmpeg 作为子进程从 App 继承这条授权，抓到的音频恒为静音
	     ——设备照样枚举得到（枚举不过是以 "Microphone" 开头的字符串），
	     所以用户看到的是「选了麦克风但投出去没声音」。
	     声明只是前提：TCC 在第一次*真正访问*音频时才写库，而 ffmpeg 自己不会触发
	     弹窗。所以前端在勾选麦克风时先用 webview 走一次 getUserMedia 把授权拿到，
	     再让 ffmpeg 接手（见 ScreenCastPanel.vue 的 ensureMicAccess）。 -->
	<key>NSMicrophoneUsageDescription</key>
	<string>HanCast 需要访问麦克风，用于在屏幕投屏时把你的讲话一起播出去。</string>
</dict>
</plist>
